# Database Credentials
POSTGRES_DB=edupulse_db
DB_USER=edupulse_user
DB_PASS=edupulse_secure_password_2026
POSTGRES_PORT=5432

# Redis Cache Credentials
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication Secrets (256-bit hex/base64 key for HMAC-SHA256)
JWT_SECRET=9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b
JWT_ACCESS_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Razorpay Payment Gateway Credentials (RBI Compliant)
RAZORPAY_KEY_ID=rzp_live_placeholder
RAZORPAY_KEY_SECRET=rzp_live_secret_placeholder
RAZORPAY_WEBHOOK_SECRET=rzp_live_webhook_secret

# Spring Boot Configuration
SPRING_PROFILES_ACTIVE=prod
SWAGGER_ENABLED=false
